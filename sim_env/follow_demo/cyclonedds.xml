<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <!-- WSL 镜像网络中的大 UDP 包可能丢失 IP 分片；在 DDS 层分片，避免依赖 IP 重组。 -->
      <MaxMessageSize>1400 B</MaxMessageSize>
      <FragmentSize>1280 B</FragmentSize>
    </General>
    <Discovery>
      <!-- 关闭组播后必须使用可发现的参与者端口，不能沿用随机端口默认值。 -->
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
